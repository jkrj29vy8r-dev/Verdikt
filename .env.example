# ─────────────────────────────────────────────────────────────────────────────
# Verdikt — Environment variables
#
# Copy to `.env.local` and fill in real values. Every variable here is validated
# at boot by `src/config/env.ts`; a missing or malformed value fails fast with a
# readable error instead of surfacing as a runtime bug in production.
#
# Convention: only `NEXT_PUBLIC_*` variables are exposed to the browser. Secrets
# (service-role keys, provider tokens) MUST NOT carry that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# App -------------------------------------------------------------------------
# Canonical, fully-qualified origin. Used for absolute URLs, OG tags, auth
# redirects. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase --------------------------------------------------------------------
# Project URL and the publishable (anon) key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Grants full access — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI intelligence engine ------------------------------------------------------
# Powers the vehicle-verdict synthesis. Server-only.
ANTHROPIC_API_KEY="sk-ant-..."

# Vehicle data providers ------------------------------------------------------
# Upstream VIN decode / history feeds. Server-only.
VIN_DATA_PROVIDER_API_KEY="your-vin-provider-key"
